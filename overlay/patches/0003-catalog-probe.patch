 bool s_sessionHandshakePaid = false;
 
+#if TAILNET_PROBE_CATALOG_LIVE
+// Catalog probe: KOReaderSyncClient's wolfSSL gate (35000 free and a 20000 block) for a
+// new handshake; the kept-session floor stays. Logs which floor applies.
+extern "C" void tailnet_probe_window_begin(const char* what);
+extern "C" void tailnet_probe_window_mark(const char* what, const char* phase);
+extern "C" void tailnet_probe_window_end(const char* what, const char* phase);
+constexpr uint32_t PROBE_MIN_FREE_HEAP_FOR_TLS = 35000;
+constexpr uint32_t PROBE_MIN_MAX_ALLOC_FOR_TLS = 20000;
+uint32_t requiredHeapFloor() {
+  if (s_sessionHandshakePaid) {
+    LOG_INF("BookOrbit", "probe floor: kept session, %u free", (unsigned)MIN_HEAP_FOR_KEPT_SESSION);
+    return MIN_HEAP_FOR_KEPT_SESSION;
+  }
+  const uint32_t maxAlloc = ESP.getMaxAllocHeap();
+  LOG_INF("BookOrbit", "probe floor: new TLS session, %u free and a %u block (largest now %u)",
+          (unsigned)PROBE_MIN_FREE_HEAP_FOR_TLS, (unsigned)PROBE_MIN_MAX_ALLOC_FOR_TLS, (unsigned)maxAlloc);
+  return maxAlloc < PROBE_MIN_MAX_ALLOC_FOR_TLS ? UINT32_MAX : PROBE_MIN_FREE_HEAP_FOR_TLS;
+}
+#else
 uint32_t requiredHeapFloor() { return s_sessionHandshakePaid ? MIN_HEAP_FOR_KEPT_SESSION : MIN_HEAP_FOR_TLS; }
+#endif
 
