+#if CROSSINK_TAILNET_WIFI_FAST_JOIN
+// The channel and access point each saved network was last joined on (NVS,
+// keyed by a hash of the SSID). A join that starts there skips the scan of
+// every channel; if it fails, the full scan runs as before.
+struct FastJoin {
+  uint8_t channel;
+  uint8_t bssid[6];
+};
+constexpr const char* FAST_JOIN_NS = "wifi_fast";
+
+void fastJoinKey(const std::string& ssid, char (&key)[16]) {
+  uint32_t h = 2166136261u;  // FNV-1a
+  for (const unsigned char c : ssid) h = (h ^ c) * 16777619u;
+  snprintf(key, sizeof(key), "j%08lx", static_cast<unsigned long>(h));
+}
+
+bool loadFastJoin(const std::string& ssid, FastJoin& out) {
+  char key[16];
+  fastJoinKey(ssid, key);
+  nvs_handle_t h;
+  if (nvs_open(FAST_JOIN_NS, NVS_READONLY, &h) != ESP_OK) return false;
+  size_t len = sizeof(out);
+  const bool ok = nvs_get_blob(h, key, &out, &len) == ESP_OK && len == sizeof(out);
+  nvs_close(h);
+  return ok && out.channel >= 1 && out.channel <= 14;
+}
+
+void saveFastJoin(const std::string& ssid) {
+  FastJoin now = {};
+  const uint8_t* bssid = WiFi.BSSID();
+  const int32_t channel = WiFi.channel();
+  if (!bssid || channel < 1 || channel > 14) return;
+  now.channel = static_cast<uint8_t>(channel);
+  memcpy(now.bssid, bssid, sizeof(now.bssid));
+  FastJoin saved;
+  if (loadFastJoin(ssid, saved) && memcmp(&saved, &now, sizeof(now)) == 0) return;  // no flash write
+  char key[16];
+  fastJoinKey(ssid, key);
+  nvs_handle_t h;
+  if (nvs_open(FAST_JOIN_NS, NVS_READWRITE, &h) != ESP_OK) return;
+  nvs_set_blob(h, key, &now, sizeof(now));
+  nvs_commit(h);
+  nvs_close(h);
+}
+#endif
