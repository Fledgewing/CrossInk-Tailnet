+    WiFi.setScanMethod(WIFI_FAST_SCAN);
+    begin(credential, last.channel, last.bssid);
+    if (joined(credential, shouldStop)) return true;
+    if (shouldStop()) {
+      WiFi.disconnect();
+      return false;
+    }
+    LOG_INF("WIFI", "Fast join failed; scanning all channels");
+    WiFi.disconnect(false, false, 1000);
+    delay(100);
+  }
+#endif
+  WiFi.setScanMethod(WIFI_ALL_CHANNEL_SCAN);
+  begin(credential);
+  if (joined(credential, shouldStop)) return true;
   WiFi.disconnect();
   return false;
