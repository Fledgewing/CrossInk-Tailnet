@@ -0,0 +1,85 @@
+#pragma once
+// CrossInk-Tailnet memory cuts (overlay patch 0004). Each cut has its own switch.
+// The overlay's build script (tailnet/tailnet_build.py) sets every one per device
+// from its switch table; the defaults here keep upstream behaviour for a build
+// without the overlay.
+
+// BookOrbit sync: free heap a new TLS session needs, and its largest free block
+// (wolfSSL gate). FLOOR 0 keeps upstream's 55000 floor and no block check.
+#ifndef CROSSINK_TAILNET_SYNC_TLS_FLOOR
+#define CROSSINK_TAILNET_SYNC_TLS_FLOOR 0
+#endif
+#ifndef CROSSINK_TAILNET_SYNC_TLS_BLOCK
+#define CROSSINK_TAILNET_SYNC_TLS_BLOCK 24576
+#endif
+
+// BookOrbit catalog: requests made while a BookOrbitCatalogClient::Session is
+// open share one keep-alive wolfSSL connection instead of a handshake each.
+#ifndef CROSSINK_TAILNET_CATALOG_KEEPALIVE
+#define CROSSINK_TAILNET_CATALOG_KEEPALIVE 0
+#endif
+
+// BookOrbit catalog: build each response's JSON filter after the download,
+// once the TLS session is freed, instead of holding it through the request.
+#ifndef CROSSINK_TAILNET_FILTER_AFTER_TLS
+#define CROSSINK_TAILNET_FILTER_AFTER_TLS 0
+#endif
+
+// Dictionary lookup worker: task stack and TCB from the heap on first lookup
+// instead of 4.4 KB of .bss in every boot.
+#ifndef CROSSINK_TAILNET_DICT_STACK_ON_DEMAND
+#define CROSSINK_TAILNET_DICT_STACK_ON_DEMAND 0
+#endif
+
+// MiniBidi: the two 1.5 KB reorder buffers allocated per call, under the bidi
+// mutex, instead of 3 KB of .bss.
+#ifndef CROSSINK_TAILNET_BIDI_ON_DEMAND
+#define CROSSINK_TAILNET_BIDI_ON_DEMAND 0
+#endif
+
+// FontCacheManager: the 2 KB scan codepoint array allocated for each prewarm
+// scope (reader page renders) instead of living in the renderer for good.
+#ifndef CROSSINK_TAILNET_FONT_SCAN_ON_DEMAND
+#define CROSSINK_TAILNET_FONT_SCAN_ON_DEMAND 0
+#endif
+
+// Arduino loopTask stack, in bytes, in a network boot (silent-reboot target >=
+// NetworkBootTarget::OTA). Other boots keep FreeInkUI's 16 KB. 0 = off.
+#ifndef CROSSINK_TAILNET_NET_LOOP_STACK
+#define CROSSINK_TAILNET_NET_LOOP_STACK 0
+#endif
+
+// BookOrbit catalog root: skip the decorative entry counts (dashboard plus two
+// book totals) when none are cached. The Want to read row is shown without a count.
+#ifndef CROSSINK_TAILNET_SKIP_ROOT_COUNTS
+#define CROSSINK_TAILNET_SKIP_ROOT_COUNTS 0
+#endif
+
+#if CROSSINK_TAILNET_NET_LOOP_STACK
+// Logs the calling task's stack high-water mark (bytes never used), for the
+// network-boot loopTask stack cut. Defined in main.cpp.
+void crossinkTailnetLogStackHighWater(const char* where);
+#define CROSSINK_TAILNET_LOG_STACK(where) crossinkTailnetLogStackHighWater(where)
+#else
+#define CROSSINK_TAILNET_LOG_STACK(where) ((void)0)
+#endif
+
+// wolfSSL arena for the BookOrbit/catalog requests, in bytes (0 = off). Reserved in one
+// block once WiFi joins in a BookOrbit network boot, before Tailscale starts, while the
+// heap still has a large block; wolfSSL allocations made on the loop task go there
+// (first fit, coalescing; heap when full), so a fragmented heap cannot fail a handshake.
+#ifndef CROSSINK_TAILNET_TLS_ARENA
+#define CROSSINK_TAILNET_TLS_ARENA 0
+#endif
+
+#if CROSSINK_TAILNET_TLS_ARENA
+#include <stdint.h>
+// src/network/TlsArena.cpp. All safe to call when the arena is not in use.
+void tlsArenaArmForBoot(uint32_t networkBootTarget);  // main.cpp, loop task, network boot
+void tlsArenaReserve();                               // WiFi joined, before Tailscale starts
+void tlsArenaRelease();                               // network ends (freed once empty)
+void tlsArenaLogRequestPeak(const char* what);        // after each request; restarts the peak
+#define CROSSINK_TAILNET_TLS_ARENA_LOG(what) tlsArenaLogRequestPeak(what)
+#else
+#define CROSSINK_TAILNET_TLS_ARENA_LOG(what) ((void)0)
+#endif
