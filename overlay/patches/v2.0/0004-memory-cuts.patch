+// A reserved wolfSSL arena for the BookOrbit and catalog requests (CROSSINK_TAILNET_TLS_ARENA).
+//
+// On the X3 the live catalog failed with 44 KB free but a 13 KB largest block: each request
+// needs 14-24 KB of wolfSSL memory, and the heap's holes no longer held it (-112/-125). The
+// arena takes one block while the heap still has a large one (WiFi joined, Tailscale not yet
+// started) and serves the wolfSSL allocations of the task that runs those requests.
+//
+// Routing: allocations by the calling task (the loop task, which arms the arena), so DERP's
+// wolfSSL in MicroLink's tunnel task keeps using the heap. Frees and reallocs go by address,
+// so a buffer freed from any task returns to where it came from. An allocation the arena
+// cannot hold falls back to the heap.
+#include <CrossInkTailnetCuts.h>
+
+#if CROSSINK_TAILNET_TLS_ARENA && defined(FREEINK_NET_WOLFSSL) && !defined(SIMULATOR)
+#include <Arduino.h>
+#include <Logging.h>
+#include <esp_heap_caps.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <wolfssl/wolfcrypt/settings.h>
+#include <wolfssl/wolfcrypt/memory.h>
+
+#include <cstdlib>
+#include <cstring>
+
+#include "SilentRestart.h"
+
+namespace {
+constexpr size_t ARENA_BYTES = static_cast<size_t>(CROSSINK_TAILNET_TLS_ARENA) & ~static_cast<size_t>(7);
+constexpr size_t HEADER = 8;               // keeps every block 8-byte aligned
+constexpr size_t MIN_SPLIT = HEADER + 16;  // smaller remainders stay with the block
+
+struct Block {
+  uint32_t size;  // header included
+  uint32_t used;
+};
+
+// Guards everything below. Nothing inside it allocates or logs.
+portMUX_TYPE s_lock = portMUX_INITIALIZER_UNLOCKED;
+uint8_t* s_arena = nullptr;
+TaskHandle_t s_requestTask = nullptr;
+bool s_armed = false;
+bool s_releasePending = false;
+size_t s_inUse = 0;
+size_t s_peak = 0;
+uint32_t s_liveBlocks = 0;
+uint32_t s_heapFallbacks = 0;
+
+bool s_hooksInstalled = false;
+wolfSSL_Malloc_cb s_prevMalloc = nullptr;
+wolfSSL_Free_cb s_prevFree = nullptr;
+wolfSSL_Realloc_cb s_prevRealloc = nullptr;
+
+Block* blockAt(const size_t offset) { return reinterpret_cast<Block*>(s_arena + offset); }
+
+bool inArena(const void* ptr) {
+  const auto* p = static_cast<const uint8_t*>(ptr);
+  return s_arena != nullptr && p >= s_arena + HEADER && p < s_arena + ARENA_BYTES;
+}
+
+// First fit. Under s_lock.
+void* arenaAlloc(const size_t size) {
+  if (s_arena == nullptr) return nullptr;
+  const size_t need = HEADER + ((size + 7) & ~static_cast<size_t>(7));
+  for (size_t offset = 0; offset < ARENA_BYTES; offset += blockAt(offset)->size) {
+    Block* block = blockAt(offset);
+    if (block->used || block->size < need) continue;
+    if (block->size - need >= MIN_SPLIT) {
+      Block* rest = blockAt(offset + need);
+      rest->size = block->size - need;
+      rest->used = 0;
+      block->size = need;
+    }
+    block->used = 1;
+    s_inUse += block->size;
+    if (s_inUse > s_peak) s_peak = s_inUse;
+    s_liveBlocks++;
+    return reinterpret_cast<uint8_t*>(block) + HEADER;
+  }
+  return nullptr;
+}
+
+// Frees and merges every run of free neighbours. Under s_lock. Returns the arena to hand
+// back to the heap when a pending release can now complete, else nullptr.
+uint8_t* arenaFree(void* ptr) {
+  Block* block = reinterpret_cast<Block*>(static_cast<uint8_t*>(ptr) - HEADER);
+  block->used = 0;
+  s_inUse -= block->size;
+  s_liveBlocks--;
+  for (size_t offset = 0; offset < ARENA_BYTES; offset += blockAt(offset)->size) {
+    Block* current = blockAt(offset);
+    if (current->used) continue;
+    while (offset + current->size < ARENA_BYTES && !blockAt(offset + current->size)->used) {
+      current->size += blockAt(offset + current->size)->size;
+    }
+  }
+  if (!s_releasePending || s_liveBlocks != 0) return nullptr;
+  uint8_t* arena = s_arena;
+  s_arena = nullptr;
+  s_releasePending = false;
+  return arena;
+}
+
+void* heapMalloc(const size_t size) { return s_prevMalloc ? s_prevMalloc(size) : malloc(size); }
+void heapFree(void* ptr) { s_prevFree ? s_prevFree(ptr) : free(ptr); }
+void* heapRealloc(void* ptr, const size_t size) { return s_prevRealloc ? s_prevRealloc(ptr, size) : realloc(ptr, size); }
+
+void* hookMalloc(size_t size) {
+  if (size != 0 && s_arena != nullptr && xTaskGetCurrentTaskHandle() == s_requestTask) {
+    portENTER_CRITICAL(&s_lock);
+    void* ptr = arenaAlloc(size);
+    if (ptr == nullptr && s_arena != nullptr) s_heapFallbacks++;
+    portEXIT_CRITICAL(&s_lock);
+    if (ptr != nullptr) return ptr;
+  }
+  return heapMalloc(size);
+}
+
+void hookFree(void* ptr) {
+  if (ptr == nullptr) return;
+  bool mine = false;
+  uint8_t* released = nullptr;
+  portENTER_CRITICAL(&s_lock);
+  if (inArena(ptr)) {
+    mine = true;
+    released = arenaFree(ptr);
+  }
+  portEXIT_CRITICAL(&s_lock);
+  if (released != nullptr) heap_caps_free(released);
+  if (!mine) heapFree(ptr);
+}
+
+void* hookRealloc(void* ptr, size_t size) {
+  if (ptr == nullptr) return hookMalloc(size);
+  if (size == 0) {
+    hookFree(ptr);
+    return nullptr;
+  }
+  size_t oldSize = 0;
+  portENTER_CRITICAL(&s_lock);
+  if (inArena(ptr)) oldSize = reinterpret_cast<Block*>(static_cast<uint8_t*>(ptr) - HEADER)->size - HEADER;
+  portEXIT_CRITICAL(&s_lock);
+  if (oldSize == 0) return heapRealloc(ptr, size);  // a heap block stays on the heap
+  void* moved = hookMalloc(size);
+  if (moved == nullptr) return nullptr;
+  memcpy(moved, ptr, oldSize < size ? oldSize : size);
+  hookFree(ptr);
+  return moved;
+}
+
+bool armsArena(const uint32_t target) {
+  switch (static_cast<NetworkBootTarget>(target)) {
+    case NetworkBootTarget::BOOKORBIT_SYNC:
+    case NetworkBootTarget::BOOKORBIT_SLEEP_SYNC:
+    case NetworkBootTarget::BOOKORBIT_CATALOG:
+    case NetworkBootTarget::BOOKORBIT_HOME_REFRESH:
+    case NetworkBootTarget::BOOKORBIT_HOME_SHELVES:
+      return true;
+    default:
+      // Not OTA (mbedTLS needs that heap) nor BOOKORBIT_DOWNLOAD, whose 16 KB record
+      // buffer wants the heap's largest block whole.
+      return false;
+  }
+}
+}  // namespace
+
+void tlsArenaArmForBoot(const uint32_t networkBootTarget) {
+  s_armed = armsArena(networkBootTarget);
+  s_requestTask = xTaskGetCurrentTaskHandle();
+  if (s_armed) LOG_INF("TLS", "TLS arena: armed for this boot (%u bytes, task %s)", (unsigned)ARENA_BYTES,
+                       pcTaskGetName(nullptr));
+}
+
+void tlsArenaReserve() {
+  if (!s_armed || s_arena != nullptr) return;
+  const uint32_t largestBefore = heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+  auto* arena = static_cast<uint8_t*>(heap_caps_malloc(ARENA_BYTES, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
+  if (arena == nullptr) {
+    LOG_ERR("TLS", "TLS arena: cannot reserve %u bytes (largest block %u); wolfSSL uses the heap",
+            (unsigned)ARENA_BYTES, (unsigned)largestBefore);
+    return;
+  }
+  auto* first = reinterpret_cast<Block*>(arena);
+  first->size = ARENA_BYTES;
+  first->used = 0;
+  if (!s_hooksInstalled) {
+    wolfSSL_GetAllocators(&s_prevMalloc, &s_prevFree, &s_prevRealloc);
+    wolfSSL_SetAllocators(hookMalloc, hookFree, hookRealloc);
+    s_hooksInstalled = true;
+  }
+  portENTER_CRITICAL(&s_lock);
+  s_inUse = 0;
+  s_peak = 0;
+  s_liveBlocks = 0;
+  s_heapFallbacks = 0;
+  s_releasePending = false;
+  s_arena = arena;
+  portEXIT_CRITICAL(&s_lock);
+  LOG_INF("TLS", "TLS arena: reserved %u bytes (largest block was %u, now %u; free %u)", (unsigned)ARENA_BYTES,
+          (unsigned)largestBefore, (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
+          (unsigned)ESP.getFreeHeap());
+}
+
+void tlsArenaRelease() {
+  uint8_t* released = nullptr;
+  uint32_t live = 0;
+  portENTER_CRITICAL(&s_lock);
+  if (s_arena != nullptr) {
+    live = s_liveBlocks;
+    if (live == 0) {
+      released = s_arena;
+      s_arena = nullptr;
+    } else {
+      s_releasePending = true;  // the last free hands it back
+    }
+  }
+  portEXIT_CRITICAL(&s_lock);
+  if (released != nullptr) {
+    heap_caps_free(released);
+    LOG_INF("TLS", "TLS arena: released");
+  } else if (live != 0) {
+    LOG_INF("TLS", "TLS arena: release waits for %u live blocks", (unsigned)live);
+  }
+}
+
+void tlsArenaLogRequestPeak(const char* what) {
+  portENTER_CRITICAL(&s_lock);
+  const bool active = s_arena != nullptr;
+  const size_t peak = s_peak;
+  const size_t inUse = s_inUse;
+  const uint32_t fallbacks = s_heapFallbacks;
+  s_peak = s_inUse;
+  s_heapFallbacks = 0;
+  portEXIT_CRITICAL(&s_lock);
+  if (!active) return;
+  LOG_INF("TLS", "TLS arena: peak %u of %u (%s; %u still in use, %u allocations went to the heap)", (unsigned)peak,
+          (unsigned)ARENA_BYTES, what, (unsigned)inUse, (unsigned)fallbacks);
+}
+
+#elif CROSSINK_TAILNET_TLS_ARENA
+// No wolfSSL (simulator): nothing to reserve.
+void tlsArenaArmForBoot(uint32_t) {}
+void tlsArenaReserve() {}
+void tlsArenaRelease() {}
+void tlsArenaLogRequestPeak(const char*) {}
+#endif
