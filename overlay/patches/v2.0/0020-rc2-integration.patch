+// CrossInk-Tailnet: the KOReader upload boot's restart payload. The folder or book path
+// waits in RTC memory beside it (a payload is 32 bits); a longer path runs in place.
+constexpr uint32_t TAILNET_SCOPE_MASK = 0x7;
+constexpr uint32_t TAILNET_FROM_FILE_TRANSFER = 1u << 3;
+constexpr uint32_t TAILNET_RETURN_TO_BOOK = 1u << 4;  // APP_STATE.openEpubPath
+constexpr uint32_t TAILNET_RUN_MENU_ACTION = 1u << 5;
+constexpr uint32_t TAILNET_RETRIED = 1u << 6;
+constexpr uint32_t TAILNET_MENU_ACTION_SHIFT = 8;
+constexpr uint32_t TAILNET_PATH_MAGIC = 0x6B6F7570u;
+constexpr size_t TAILNET_PATH_CAPACITY = 256;
+#ifndef RTC_NOINIT_ATTR
+#define RTC_NOINIT_ATTR
+#endif
+RTC_NOINIT_ATTR uint32_t tailnetPathMagic;
+RTC_NOINIT_ATTR char tailnetPath[TAILNET_PATH_CAPACITY];
 }  // namespace
 
+// On the C3, Tailscale only runs in a network boot with the framebuffer parked: an
+// upload to a KOReader server on the tailnet restarts into the overlay's boot for it
+// (Tailscale on demand there, so a public server costs only the restart). `retry`: a
+// prompt in that boot had to turn the network off; run the sync once more on a fresh boot.
+bool StatsUploadActivity::restartIntoTailnetBoot(const bool retry) {
+#ifndef SIMULATOR
+  if (!retry && (tailnetBoot || !tailnet_koreader_upload_redirect())) return false;
+  if (retry && (!tailnetBoot || tailnetRetried)) return false;
+  if (path.size() >= TAILNET_PATH_CAPACITY) {
+    LOG_ERR("StatsSync", "Tailscale: path too long for the upload boot; syncing here: %s", path.c_str());
+    return false;
+  }
+  uint32_t payload = static_cast<uint32_t>(scope) & TAILNET_SCOPE_MASK;
+  if (fromFileTransfer) payload |= TAILNET_FROM_FILE_TRANSFER;
+  if (!returnBookPath.empty() && returnBookPath == APP_STATE.openEpubPath) payload |= TAILNET_RETURN_TO_BOOK;
+  if (runReturnMenuAction) payload |= TAILNET_RUN_MENU_ACTION | (uint32_t{returnMenuAction} << TAILNET_MENU_ACTION_SHIFT);
+  if (retry) payload |= TAILNET_RETRIED;
+  memcpy(tailnetPath, path.c_str(), path.size() + 1);
+  tailnetPathMagic = TAILNET_PATH_MAGIC;
+  LOG_INF("StatsSync", "Tailscale: %s the KOReader upload in its network boot (payload %lu)",
+          retry ? "restarting" : "running", static_cast<unsigned long>(payload));
+  closeTransfer();
+  restartOnLeave = false;  // this restart replaces the one on leave
+  silentRestartToNetwork(static_cast<NetworkBootTarget>(TAILNET_KOREADER_UPLOAD_TARGET), payload);
+  return true;
+#else
+  (void)retry;
+  return false;
+#endif
+}
+
+bool StatsUploadActivity::startInTailnetBoot(GfxRenderer& renderer, MappedInputManager& input, const uint32_t payload) {
+  const uint32_t rawScope = payload & TAILNET_SCOPE_MASK;
+  if (rawScope > static_cast<uint32_t>(Scope::Clippings) || tailnetPathMagic != TAILNET_PATH_MAGIC) return false;
+  tailnetPathMagic = 0;
+  tailnetPath[TAILNET_PATH_CAPACITY - 1] = '\0';
+  auto sync = makeUniqueNoThrow<StatsUploadActivity>(renderer, input, std::string(tailnetPath),
+                                                     static_cast<Scope>(rawScope), true);
+  if (!sync) {
+    LOG_ERR("StatsSync", "OOM: KOReader upload after minimal boot (free=%u maxAlloc=%u)", ESP.getFreeHeap(),
+            ESP.getMaxAllocHeap());
+    return false;
+  }
+  sync->tailnetBoot = true;
+  sync->tailnetRetried = (payload & TAILNET_RETRIED) != 0;
+  sync->restartOnLeave = true;  // back to the normal boot on every way out
+  sync->fromFileTransfer = (payload & TAILNET_FROM_FILE_TRANSFER) != 0;
+  if ((payload & TAILNET_RETURN_TO_BOOK) != 0) sync->returnBookPath = APP_STATE.openEpubPath;
+  if ((payload & TAILNET_RUN_MENU_ACTION) != 0) {
+    sync->runReturnMenuAction = true;
+    sync->returnMenuAction = static_cast<uint8_t>(payload >> TAILNET_MENU_ACTION_SHIFT);
+  }
+  activityManager.replaceActivity(std::move(sync));
+  return true;
+}
