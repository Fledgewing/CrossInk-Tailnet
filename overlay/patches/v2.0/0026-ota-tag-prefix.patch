diff --git a/src/network/OtaReleasePick.cpp b/src/network/OtaReleasePick.cpp
new file mode 100644
index 00000000..db2297a4
--- /dev/null
+++ b/src/network/OtaReleasePick.cpp
@@ -0,0 +1,27 @@
+#include "OtaReleasePick.h"
+
+#include <cstring>
+
+#include "FirmwareVersion.h"
+
+namespace ota_release_pick {
+
+const char* versionOf(const char* tag, const char* prefix) {
+  if (tag == nullptr) return nullptr;
+  if (prefix == nullptr || prefix[0] == '\0') return tag;
+  const size_t n = strlen(prefix);
+  return strncmp(tag, prefix, n) == 0 ? tag + n : nullptr;
+}
+
+void keep(ReleaseJsonParser::Release& newest, const ReleaseJsonParser::Release& candidate, const Filter& filter) {
+  const char* version = versionOf(candidate.tagName, filter.tagPrefix);
+  if (version == nullptr || !firmware_version::isComparable(version)) return;
+  if (candidate.prerelease && !filter.includePrereleases) return;
+  if (newest.tagFound &&
+      firmware_version::compare(version, versionOf(newest.tagName, filter.tagPrefix)) <= 0) {
+    return;
+  }
+  newest = candidate;
+}
+
+}  // namespace ota_release_pick
diff --git a/src/network/OtaReleasePick.h b/src/network/OtaReleasePick.h
new file mode 100644
index 00000000..0880b2c8
--- /dev/null
+++ b/src/network/OtaReleasePick.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <ReleaseJsonParser.h>
+
+// Orbify (overlay patch "ota-tag-prefix"): picks the firmware release to offer from a GET
+// /releases list. Orbify releases Android and firmware from one repo, so the firmware's
+// releases carry a tag prefix (xteink-v1.6.1.101+bookorbit.8) and never take "latest"; the
+// updater reads the list and keeps the newest release with this firmware's prefix. Pure
+// logic, kept out of OtaUpdater.cpp (device-only) so a host test covers it.
+namespace ota_release_pick {
+
+struct Filter {
+  // Tag prefix of this firmware's releases; "" accepts every tag (upstream's behaviour).
+  const char* tagPrefix;
+  // False skips releases GitHub marks as pre-releases.
+  bool includePrereleases;
+};
+
+// The version part of `tag`: what follows the prefix, or nullptr when `tag` lacks it.
+const char* versionOf(const char* tag, const char* prefix);
+
+// Keeps in `newest` the newest release `filter` accepts; on a tie the earlier (more recent)
+// entry stays. `newest` starts value-initialised (tagFound false).
+void keep(ReleaseJsonParser::Release& newest, const ReleaseJsonParser::Release& candidate, const Filter& filter);
+
+}  // namespace ota_release_pick
