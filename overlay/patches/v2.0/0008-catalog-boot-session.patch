+#if CATALOG_BOOT_SESSION
+void BookOrbitCatalogClient::openBootSession() {
+  if (s_bootSession) return;
+  if (!s_catalogConnection) {
+    s_catalogConnection = makeUniqueNoThrow<freeink::SecureHttpClient>();
+    if (!s_catalogConnection) {
+      LOG_ERR("BookOrbit", "Catalog boot connection allocation failed; requests open their own");
+      return;
+    }
+    s_catalogConnection->setReuse(true);
+  }
+  s_bootSession = true;
+  s_bootSessionRequests = 0;
+  LOG_INF("BookOrbit", "Catalog boot session open: every request of this boot shares one TLS connection");
+}
+
+void BookOrbitCatalogClient::closeBootSession(const char* why) {
+  if (!s_bootSession) return;
+  s_bootSession = false;
+  if (s_catalogConnection) {
+    s_catalogConnection->end();
+    s_catalogConnection.reset();
+  }
+  LOG_INF("BookOrbit", "Catalog boot session closed (%s) after %u requests on its last connection", why,
+          static_cast<unsigned>(s_bootSessionRequests));
+}
+#else
+void BookOrbitCatalogClient::openBootSession() {}
+void BookOrbitCatalogClient::closeBootSession(const char*) {}
+#endif
