 namespace fui = freeink::ui;
 
+// --- Catalog row strings (Entry::text) -------------------------------------------------
+using CatalogRow = BookOrbitCatalogBrowserActivity::Entry;
+using RowText = BookOrbitCatalogBrowserActivity::Text;
+#if CROSSINK_TAILNET_PACKED_ROWS
+using PackedText = BookOrbitCatalogBrowserActivity::PackedText;
+constexpr size_t TEXT_COUNT = BookOrbitCatalogBrowserActivity::TEXT_COUNT;
+
+size_t PackedText::total() const {
+  size_t n = 0;
+  for (const uint16_t len : len_) n += len + 1u;
+  return n;
+}
+
+PackedText::PackedText(const PackedText& other) { *this = other; }
+
+PackedText::PackedText(PackedText&& other) noexcept : buf_(other.buf_), len_(other.len_) {
+  other.buf_ = nullptr;
+  other.len_.fill(0);
+}
+
+PackedText& PackedText::operator=(const PackedText& other) {
+  if (this == &other) return *this;
+  char* copy = nullptr;
+  if (other.buf_ != nullptr) {
+    const size_t n = other.total();
+    copy = static_cast<char*>(malloc(n));
+    if (copy == nullptr) return *this;  // out of memory: this row keeps its own text
+    memcpy(copy, other.buf_, n);
+  }
+  free(buf_);
+  buf_ = copy;
+  len_ = copy ? other.len_ : decltype(len_){};
+  return *this;
+}
+
+PackedText& PackedText::operator=(PackedText&& other) noexcept {
+  if (this == &other) return *this;
+  free(buf_);
+  buf_ = other.buf_;
+  len_ = other.len_;
+  other.buf_ = nullptr;
+  other.len_.fill(0);
+  return *this;
+}
+
+PackedText::~PackedText() { free(buf_); }
+
+std::string_view PackedText::get(const RowText field) const {
+  const size_t index = static_cast<size_t>(field);
+  if (buf_ == nullptr || len_[index] == 0) return std::string_view("", 0);
+  size_t offset = 0;
+  for (size_t i = 0; i < index; i++) offset += len_[i] + 1u;
+  return std::string_view(buf_ + offset, len_[index]);
+}
+
+bool PackedText::setAll(const std::array<std::string_view, TEXT_COUNT>& values) {
+  size_t n = 0;
+  bool any = false;
+  for (const auto& value : values) {
+    if (value.size() > UINT16_MAX) return false;
+    n += value.size() + 1;
+    any = any || !value.empty();
+  }
+  // Built before the old block goes: a value may point into it.
+  char* block = nullptr;
+  if (any) {
+    block = static_cast<char*>(malloc(n));
+    if (block == nullptr) return false;
+    char* out = block;
+    for (const auto& value : values) {
+      memcpy(out, value.data(), value.size());
+      out += value.size();
+      *out++ = '\0';
+    }
+  }
+  free(buf_);
+  buf_ = block;
+  for (size_t i = 0; i < TEXT_COUNT; i++) len_[i] = block ? static_cast<uint16_t>(values[i].size()) : 0;
+  return true;
+}
+
+bool PackedText::set(const RowText field, const std::string_view value) {
+  std::array<std::string_view, TEXT_COUNT> values;
+  for (size_t i = 0; i < TEXT_COUNT; i++) values[i] = get(static_cast<RowText>(i));
+  values[static_cast<size_t>(field)] = value;
+  return setAll(values);
+}
+
+std::string_view CatalogRow::text(const RowText field) const { return text_.get(field); }
+void CatalogRow::setText(const RowText field, const std::string_view value) { text_.set(field, value); }
+void CatalogRow::setTexts(const std::string_view title, const std::string_view subtitle,
+                          const std::string_view sectionId, const std::string_view seriesId,
+                          const std::string_view path) {
+  text_.setAll({title, subtitle, sectionId, seriesId, path});
+}
+size_t CatalogRow::textBytes() const { return text_.bytes(); }
+#else
+std::string_view CatalogRow::text(const RowText field) const {
+  return text_[static_cast<size_t>(field)];
+}
+void CatalogRow::setText(const RowText field, const std::string_view value) {
+  text_[static_cast<size_t>(field)].assign(value.data(), value.size());
+}
+void CatalogRow::setTexts(const std::string_view title, const std::string_view subtitle,
+                          const std::string_view sectionId, const std::string_view seriesId,
+                          const std::string_view path) {
+  setTitle(title);
+  setSubtitle(subtitle);
+  setSectionId(sectionId);
+  setSeriesId(seriesId);
+  setPath(path);
+}
+size_t CatalogRow::textBytes() const {
+  size_t n = 0;
+  for (const auto& text : text_) n += text.capacity() > 15 ? text.capacity() + 1 : 0;  // beyond the SSO buffer
+  return n;
+}
+#endif
