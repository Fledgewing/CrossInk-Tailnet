+    Path,      // SD path: LOCAL_BOOK entries, and BOOK entries already on the device
+    Count
+  };
+  static constexpr size_t TEXT_COUNT = static_cast<size_t>(Text::Count);
+
+#if CROSSINK_TAILNET_PACKED_ROWS
+  // The strings of one row in one heap block: "title\0subtitle\0sectionId\0seriesId\0path\0",
+  // none when all are empty. Setting a field rebuilds the block.
+  class PackedText {
+   public:
+    PackedText() = default;
+    PackedText(const PackedText& other);
+    PackedText(PackedText&& other) noexcept;
