+    bool setAll(const std::array<std::string_view, TEXT_COUNT>& values);
+    // Heap bytes held (the block), for the page-load log.
+    size_t bytes() const { return buf_ ? total() : 0; }
+
+   private:
+    size_t total() const;  // block size, NULs included
+    char* buf_ = nullptr;
+    std::array<uint16_t, TEXT_COUNT> len_{};
+  };
+#endif
+
+  struct Entry {
+    EntryType type;
+    std::string_view title() const { return text(Text::Title); }
+    std::string_view subtitle() const { return text(Text::Subtitle); }
+    std::string_view sectionId() const { return text(Text::SectionId); }
+    std::string_view seriesId() const { return text(Text::SeriesId); }
+    std::string_view path() const { return text(Text::Path); }
+    void setTitle(std::string_view value) { setText(Text::Title, value); }
+    void setSubtitle(std::string_view value) { setText(Text::Subtitle, value); }
+    void setSectionId(std::string_view value) { setText(Text::SectionId, value); }
+    void setSeriesId(std::string_view value) { setText(Text::SeriesId, value); }
+    void setPath(std::string_view value) { setText(Text::Path, value); }
+    // Every field at once (one allocation with CROSSINK_TAILNET_PACKED_ROWS).
+    void setTexts(std::string_view title, std::string_view subtitle, std::string_view sectionId,
+                  std::string_view seriesId, std::string_view path);
+    std::string_view text(Text field) const;
+    void setText(Text field, std::string_view value);
+    // Heap bytes the row's strings hold beyond the Entry itself (page-load log).
+    size_t textBytes() const;
     int64_t bookId = 0;
     bool onDevice = false;  // BOOK entries: a matching file already exists on the device (at `path`)
     uint16_t page = 0;      // server page the row came from; 0 for the root and the on-device lists
     // Length of `title` before its " (count)" badge, 0 when it has none. A listing opened
     // from the row is titled without it: its header counts what the listing holds.
     uint16_t badgeAt = 0;
+
+   private:
+#if CROSSINK_TAILNET_PACKED_ROWS
+    PackedText text_;
+#else
+    std::array<std::string, TEXT_COUNT> text_;
+#endif
