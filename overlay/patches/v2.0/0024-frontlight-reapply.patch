index 7c83ab68..8cfea48b 100644
--- a/lib/hal/HalFrontlight.cpp
+++ b/lib/hal/HalFrontlight.cpp
@@ -41,3 +41,9 @@ void HalFrontlight::setOn(const bool on) {
   lit = on;
   manager.setBrightness(lit ? lastBrightness : 0);
 }
+
+void HalFrontlight::reapply(const char* const why) {
+  if (!manager.present()) return;
+  manager.setBrightness(lit ? lastBrightness : 0);
+  LOG_INF("LIGHT", "reapply %s: %u%% lit=%d", why, lastBrightness, lit ? 1 : 0);
+}
