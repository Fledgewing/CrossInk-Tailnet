+#if CROSSINK_TAILNET_FRONTLIGHT_REAPPLY
+// Writes the frontlight to the driver again once the first paint of this boot is on the
+// panel, and once more a second later (CrossInkTailnetCuts.h): the light comes up in
+// setup() while the panel powers up, and a wake could leave it dark with its state on.
+// Main task only, like every other Frontlight call. No-op without a frontlight.
+static void reapplyFrontlightAfterFirstPaint() {
+  static uint8_t done = 0;
+  static unsigned long firstAt = 0;
+  if (done >= 2 || frontlightReapplyFrom == 0 || !Frontlight.present()) return;
+  const unsigned long now = millis();
+  if (done == 0) {
+    if (static_cast<long>(now - frontlightReapplyFrom) < 0) return;
+    // The render task holds the lock while it draws: wait for the first paint to finish.
+    RenderLock lock(RenderLock::Mode::Try);
+    if (!lock.ownsLock()) return;
+    Frontlight.reapply("after first paint");
+    firstAt = now;
+    done = 1;
+  } else if (now - firstAt >= FRONTLIGHT_REAPPLY_GUARD_MS) {
+    Frontlight.reapply("1 s after first paint");
+    done = 2;
+  }
+}
+#endif
