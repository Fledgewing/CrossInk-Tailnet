+BookOrbitDownloadResume BookOrbitCatalogBrowserActivity::listingSnapshot() const {
+  BookOrbitDownloadResume resume;
+  resume.listQuery = listQuery;
+  resume.listDefaultReadStatus = listDefaultReadStatus;
+  resume.listTitle = listTitle;
+  resume.listPage = listPage;
+  resume.booksFromFacet = booksFromFacet;
+  resume.selectorIndex = selectorIndex;
+  resume.topIndex = topIndex;
+  resume.facetSectionId = facetSectionId;
+  resume.facetTitle = facetTitle;
+  resume.facetPage = facetPage;
+  resume.facetSelectorIndex = facetSelectorIndex;
+  resume.facetTopIndex = facetTopIndex;
+  resume.fromHome = downloadFromHome;
+  return resume;
+}
+
+#if CROSSINK_TAILNET_DOWNLOAD_BACK_TO_CATALOG
+bool BookOrbitCatalogBrowserActivity::restartBackToCatalog(const int failure) {
+  BookOrbitDownloadResume listing = listingSnapshot();
+  listing.failure = failure;
+  if (!BookOrbitCatalogListCache::saveCatalogReturn(listing)) {
+    LOG_ERR("BookOrbit", "Cannot save the listing for the catalog restart; ending on Home");
+    return false;
+  }
+  LOG_INF("BookOrbit", "Download done (failure %d): restarting into the catalog at page %d (row %d, top %d)", failure,
+          listPage, selectorIndex, topIndex);
+  silentRestartToNetwork(NetworkBootTarget::BOOKORBIT_CATALOG);
+  // Only returns when deep sleep is already under way, which ends this session anyway.
+  return true;
+}
+#endif
